PORT=5000
HOST=0.0.0.0

# Local frontend / production frontend URL(s), comma-separated
CORS_ORIGIN=https://www.pranavone.in,https://pranavone.in,https://www.bizvyapar.in,https://bizvyapar.in,https://bizvyapar-in-frontend.vercel.app,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# MongoDB (auth, profiles, registrations, settings)
# From Atlas → Connect → Drivers:
# mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?appName=bizvyapar
MONGODB_URI=
MONGODB_DB=pranavone

# Displayed workshop price (paise)
WORKSHOP_AMOUNT_PAISE=100

# Auth JWT (name + email + phone login)
AUTH_JWT_SECRET=change-me-long-random-auth-jwt-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# TredsDash admin panel (/tredsdash)
ADMIN_DASHBOARD_NAME=TredsDash
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Sub-admin (sales team): can only open the Sales section. Quote values that contain #
SUBADMIN_USERNAME=sales
SUBADMIN_PASSWORD=
ADMIN_SESSION_SECRET=change-me-long-random-secret
# Keep-alive target
# KEEPALIVE_URL=https://pranavone-api.onrender.com/health

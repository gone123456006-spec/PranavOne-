# Copy these into Vercel → Project → Settings → Environment Variables
# Never commit real secrets.

# —— Frontend → API (when backend is on Render) ——
# VITE_API_BASE_URL=https://pranavone-api.onrender.com

# —— Backend (Express on /api or Render) ——
# Your live frontend URL(s), comma-separated
CORS_ORIGIN=https://www.pranavone.in,https://pranavone.in

# MongoDB connection string
MONGODB_URI=
MONGODB_DB=pranavone

# Keep-alive: https://pranavone-api.onrender.com/health
KEEPALIVE_URL=

WORKSHOP_AMOUNT_PAISE=100

AUTH_JWT_SECRET=

ADMIN_DASHBOARD_NAME=TredsDash
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SUBADMIN_USERNAME=sales
SUBADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

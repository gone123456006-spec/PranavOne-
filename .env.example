# Copy these into Vercel → Project → Settings → Environment Variables
# Never commit real secrets.

# —— Frontend → API (when backend is on Render) ——
# VITE_API_BASE_URL=https://bizvyapar-api.onrender.com

# —— Backend (Express on /api or Render) ——
# Your live frontend URL(s), comma-separated
CORS_ORIGIN=https://your-app.vercel.app

# MongoDB connection string
MONGODB_URI=
MONGODB_DB=bizvyapar

# Keep-alive: https://YOUR-SERVICE.onrender.com/health
KEEPALIVE_URL=

WORKSHOP_AMOUNT_PAISE=100

WEBINAR_LINK=https://meet.google.com/your-webinar-link

AUTH_JWT_SECRET=

ADMIN_DASHBOARD_NAME=TredsDash
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SENDER_NAME=BizVyapar
